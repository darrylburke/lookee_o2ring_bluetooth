# copy to .env (git-ignored) and fill in
O2RING_DB_HOST=127.0.0.1
O2RING_DB_PORT=3306
O2RING_DB_NAME=lookee_data
O2RING_DB_USER=lookee
O2RING_DB_PASSWORD=change-me

# about you (optional) - only used to pick which published reference bands the reports show next to your movement
# counts (men move more than women in the studies; position changes fall with age). Nothing here is sent anywhere.
#O2RING_SEX=m                  # m or f
#O2RING_BIRTH_YEAR=1976
#O2RING_HEIGHT_CM=180          # height and weight are stored with each night's analysis as BMI, for your own reference
#O2RING_WEIGHT_KG=81

# report server (optional)
#HOST=127.0.0.1
#PORT=3000
#O2RING_ALLOWED_HOSTS=nas.lan,192.168.1.20   # extra host names the server may be reached under
#O2RING_PYTHON=/path/to/.venv/bin/python   # interpreter with pymysql, used when combining recordings

# "Ask" panel (optional) - questions about your data answered by Claude. Greyed out until a key is set.
# Asking sends the figures the model looks up (metrics, drops, averaged signals, tags, notes) to Anthropic's API.
#ANTHROPIC_API_KEY=sk-ant-...
#O2RING_LLM_MODEL=claude-opus-5
#O2RING_LLM_SEND_NOTES=0        # keep your free-text notes away from the model (default: readable)
#O2RING_LLM_DAILY_LIMIT=100     # questions per day
# Optional extra: let the model also write its own read-only SELECT queries. Needs a separate MySQL user that can
# only SELECT (INSTALL.md has the statements) - the server checks its grants and keeps the tool off otherwise.
#O2RING_LLM_SQL=1
#O2RING_DB_RO_USER=lookee_ro
#O2RING_DB_RO_PASSWORD=change-me
