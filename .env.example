# copy to .env (git-ignored) and fill in
O2RING_DB_HOST=127.0.0.1
O2RING_DB_PORT=3306
O2RING_DB_NAME=lookee_data
O2RING_DB_USER=lookee
O2RING_DB_PASSWORD=change-me

